<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260520-create-user-progress" author="artsobol">
        <createTable tableName="user_progress">
            <column name="user_id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_progress"/>
            </column>
            <column name="total_workouts" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="current_streak" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="longest_streak" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_workout_date" type="date"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
